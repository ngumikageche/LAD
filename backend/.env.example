# Core
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lad_db
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email delivery (Portal + Email is the default feedback choice)
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_USERNAME=notifications@example.edu
SMTP_PASSWORD=replace-me
SMTP_FROM=notifications@example.edu
SMTP_STARTTLS=true

# Optional paid SMS provider. The endpoint must accept:
# {"to": "...", "message": "...", "sender_id": "..."}
SMS_WEBHOOK_URL=
SMS_API_KEY=
SMS_SENDER_ID=LAD
